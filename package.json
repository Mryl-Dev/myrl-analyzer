{
  "name": "vscode-mryl",
  "displayName": "vscode-mryl",
  "description": "Syntax highlighting and full LSP support for the Mryl programming language.",
  "version": "0.0.1",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extensions.js",
  "publisher": "mryl-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mryl-Dev/myrl-analyzer"
  },
  "contributes": {
    "languages": [
      {
        "id": "mryl",
        "aliases": [
          "Mryl",
          "mryl"
        ],
        "extensions": [
          ".ml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mryl",
        "scopeName": "source.mryl",
        "path": "./syntaxes/mryl.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Mryl Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/mryl-color-theme.json"
      }
    ]
  },
  "files": [
    "dist",
    "server",
    "syntaxes",
    "themes",
    "README.md",
    "LICENSE",
    "package.json",
    "assets/icon.png"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
