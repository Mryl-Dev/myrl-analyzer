// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm: watch",
			"type": "shell",
			"command": "npm run watch",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": {
				"base": "$tsc-watch",
				"applyTo": "allDocuments",
				"owner": "webpack",
				"severity": "error",
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*Compiler starting.*",
					"endsPattern": ".*Compiler finished.*"
				}
			}
		}
	]
}
