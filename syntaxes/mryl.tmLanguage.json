{
  "scopeName": "source.mryl",
  "fileTypes": ["ml"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#brackets" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#generics" },
    { "include": "#enumVariants" },
    { "include": "#functionCalls" },
    { "include": "#fieldAccess" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#structs" },
    { "include": "#identifiers" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mryl",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.mryl" } },
          "end": "$",
          "contentName": "comment.line.content.mryl"
        },
        {
          "name": "comment.block.mryl",
          "begin": "/\\*",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.mryl" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.mryl" } },
          "contentName": "comment.block.content.mryl"
        }
      ]
    },
    "strings": {
    "patterns": [
      {
        "name": "string.quoted.double.mryl",
        "begin": "\"",
        "end": "\"",
        "patterns": [
          {
            "name": "constant.character.escape.mryl",
            "match": "\\\\."
          }
        ]
      }
    ]
    },
    "brackets": {
    "patterns": [
      {
        "name": "punctuation.bracket.round.mryl",
        "match": "[()]"
      },
      {
        "name": "punctuation.bracket.curly.mryl",
        "match": "[{}]"
      },
      {
        "name": "punctuation.bracket.square.mryl",
        "match": "[\\[\\]]"
      }
    ]
    },
    "keywords": {
    "patterns": [
      {
        "name": "keyword.control.mryl",
        "match": "\\b(if|else|while|for|in|match|case|default|break|continue|return|async|await)\\b"
      }
    ]
    },
    "declarations": {
    "patterns": [
      {
        "name": "keyword.declaration.mryl",
        "match": "\\b(fn|let|const|struct|enum|impl)\\b"
      },
      {
        "match": "\\bstruct\\s+([A-Z][A-Za-z0-9_]*)",
        "captures": { "1": { "name": "entity.name.type.struct.mryl" } }
      },
      {
        "match": "\\benum\\s+([A-Z][A-Za-z0-9_]*)",
        "captures": { "1": { "name": "entity.name.type.enum.mryl" } }
      }
    ]
    },
    "types": {
    "patterns": [
      {
        "name": "storage.type.primitive.mryl",
        "match": "\\b(int|bool|string|void|any)\\b"
      },
      {
        "name": "storage.type.result.mryl",
        "match": "\\b(Result|Option)\\b"
      }
    ]
    },
    "generics": {
    "patterns": [
      {
        "name": "entity.name.type.generic.mryl",
        "match": "<[A-Z][A-Za-z0-9_]*>"
      }
    ]
    },
    "enumVariants": {
    "patterns": [
      {
        "name": "entity.name.enum.variant.mryl",
        "match": "\\b[A-Z][A-Za-z0-9_]*::[A-Z][A-Za-z0-9_]*\\b"
      }
    ]
    },
    "functionCalls": {
    "patterns": [
      {
        "name": "entity.name.function.call.mryl",
        "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()"
      }
    ]
    },
    "fieldAccess": {
    "patterns": [
      {
        "name": "entity.name.field.mryl",
        "match": "\\.[a-z_][A-Za-z0-9_]*"
      }
    ]
    },
    "structs": {
    "patterns": [
      {
        "name": "entity.name.type.struct.mryl",
        "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
      }
    ]
    },
    "constants": {
    "patterns": [
      {
        "name": "constant.language.boolean.mryl",
        "match": "\\b(true|false)\\b"
      },
      {
        "name": "constant.language.result.mryl",
        "match": "\\b(Ok|Err|Some|None)\\b"
      }
    ]
    },
    "operators": {
    "patterns": [
      {
        "name": "keyword.operator.mryl",
        "match": "(==|!=|<=|>=|->|\\+|-|\\*|/|%|<|>|=)"
      }
    ]
    },
    "identifiers": {
    "patterns": [
      {
        "name": "variable.other.mryl",
        "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
      }
    ]
    },
    "numbers": {
    "patterns": [
      {
        "name": "constant.numeric.mryl",
        "match": "\\b[0-9]+\\b"
      }
    ]
    },
    "typesUsage": {
    "patterns": [
      {
        "name": "entity.name.type.mryl",
        "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*\\{)"
      },
      {
        "name": "entity.name.type.mryl",
        "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*\\()"
      },
      {
        "name": "entity.name.type.mryl",
        "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*::)"
      }
    ]
    }
  }
}